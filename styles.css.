* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: "Segoe UI", Arial, sans-serif; background: #0b1230; color: #fff; }
img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }

.header { display: flex; align-items: center; justify-content: space-between; padding: 16px 48px; background: #0b1230; }
.logo { height: 48px; width: auto; }
.header nav { display: flex; gap: 32px; }
.header nav a:hover { color: #7fb2ff; }

.banner { position: relative; min-height: 520px; display: flex; align-items: center; padding: 0 48px;
  background: url("images/banner-background.png") center / cover no-repeat; }
.banner__img { position: absolute; right: 48px; bottom: 0; height: 90%; width: auto; }
.banner__text { max-width: 460px; position: relative; z-index: 1; }
.banner__text h1 { font-size: 3rem; margin-bottom: 12px; }
.banner__text p { margin-bottom: 24px; line-height: 1.5; }

.btn { display: inline-block; padding: 12px 28px; border-radius: 24px; background: #1e5eff; font-weight: 600; }
.btn:hover { background: #3f7aff; }

.section { padding: 56px 48px; }
.section--dark { background: #060a1f; }
.section h2 { font-size: 1.8rem; margin-bottom: 24px; }

.grid { display: grid; gap: 16px; }
.grid img { width: 100%; height: 100%; object-fit: cover; border-radius: 10px; }
.grid--5 { grid-template-columns: repeat(5, 1fr); }
.grid--4 { grid-template-columns: repeat(4, 1fr); }
.grid--3 { grid-template-columns: repeat(3, 1fr); }
.grid--2 { grid-template-columns: repeat(2, 1fr); }

.more { text-align: center; padding: 96px 24px; background: url("images/more-background.jpeg") center / cover no-repeat; }
.more h2 { font-size: 2rem; margin-bottom: 24px; }

.footer { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 32px; background: #060a1f; }

@media (max-width: 900px) {
  .header { flex-direction: column; gap: 12px; padding: 16px 24px; }
  .grid--5, .grid--4 { grid-template-columns: repeat(2, 1fr); }
  .grid--3 { grid-template-columns: 1fr; }
  .banner { padding: 0 24px; flex-direction: column; justify-content: center; text-align: center; }
  .banner__img { display: none; }
  .section { padding: 40px 24px; }
}
@media (max-width: 560px) {
  .grid--2, .grid--5, .grid--4 { grid-template-columns: 1fr; }
}
